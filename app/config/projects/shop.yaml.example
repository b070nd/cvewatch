# Copy to <name>.yaml (any *.yaml in this folder is loaded and stays untracked),
# or let `cvewatch init -repo /path/to/repo` write one for you.
name: shop
envs: [dev, int, staging, prod]   # any names (local, qa-2 ...); omit for the old default: dev, int, staging, prod
# since: 2026-01-01              # vulnerabilities published before this day are not checked
techs:                            # generic: every environment runs these; names from the catalog or your own in techs.yaml
  - {name: php, version: "8.2"}
  - {name: elasticsearch, version: "8.11"}
  - {name: magento, version: "2.4.7"}
  # - {name: phpmyadmin, version: "5.2", envs: [dev]}   # present only in these environments
lockfiles:                        # re-read every run
  - {type: composer, path: /path/to/shop/composer.lock}
  - {type: npm, path: /path/to/shop/package-lock.json}
  # - {type: cyclonedx, path: /path/to/shop-prod.cdx.json, env: prod}   # an SBOM for one environment
when@prod:                        # only what differs there from the lists above (like Symfony's when@prod)
  techs: {php: "8.2.30"}          # a version that differs, or a tech that exists only there
  image: registry.example/shop@sha256:...   # recorded only
# when@dev:
#   exclude: [elasticsearch]        # a generic tech that does not run there
